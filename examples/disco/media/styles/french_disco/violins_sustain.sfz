// Violin section, sustained with vibrato: VS Chamber Orchestra 2 Community Edition (CC0 1.0), mapped for odawg's disco demo.
// Generated from the file names; the names run an octave low (A3 sounds A4).
<control> default_path=../../vsco/Strings/Violin Section/susVib/
<global> ampeg_release=0.6
<group> lokey=0 hikey=56 pitch_keycenter=55
<region> sample=VlnEns_susVib_G2_v1.wav lovel=0 hivel=80
<region> sample=VlnEns_susVib_G2_v2.wav lovel=81 hivel=127
