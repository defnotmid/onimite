{
  "$description": "Orbit launch card: design tokens exported by the designer (W3C design tokens format).",
  "color": {
    "$type": "color",
    "canvas":  { "$value": "#f4efe6", "$description": "page background" },
    "surface": { "$value": "#fffaf3", "$description": "card" },
    "well":    { "$value": "#ece4f2", "$description": "illustration well" },
    "ink":     { "$value": "#1f1b2e", "$description": "headings, price" },
    "muted":   { "$value": "#7b738a", "$description": "secondary text" },
    "brand":   { "$value": "#5b5bd6", "$description": "buttons, badge" },
    "accent":  { "$value": "#ff8a5b", "$description": "highlights, redlines" },
    "glow":    { "$value": "#7fe0c9", "$description": "the speaker's light ring" }
  },
  "font": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "Space Grotesk", "fontWeight": 500, "fontSize": 76, "letterSpacing": -2 } },
    "body":    { "$value": { "fontFamily": "DM Sans", "fontWeight": 500, "fontSize": 32, "letterSpacing": 0 } },
    "label":   { "$value": { "fontFamily": "JetBrains Mono", "fontWeight": 400, "fontSize": 22, "letterSpacing": 1 } }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": 8 },
    "sm": { "$value": 16 },
    "md": { "$value": 24 },
    "lg": { "$value": 40 },
    "xl": { "$value": 56 }
  },
  "radius": {
    "$type": "dimension",
    "sm":   { "$value": 12 },
    "md":   { "$value": 24 },
    "lg":   { "$value": 40 },
    "pill": { "$value": 999 }
  },
  "shadow": {
    "$type": "shadow",
    "card": { "$value": { "offsetX": 0, "offsetY": 28, "blur": 44, "color": "#2b1d12", "opacity": 0.18 } }
  },
  "content": {
    "$type": "string",
    "name":    { "$value": "Orbit Mini" },
    "tagline": { "$value": "Room-filling sound in a speaker that fits in your palm." },
    "price":   { "$value": "$129" },
    "cta":     { "$value": "Add to cart" },
    "done":    { "$value": "Added" }
  }
}
