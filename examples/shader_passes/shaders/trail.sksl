// The trail: its own last frame, turned by a slow swirl, spread a little
// and faded, under this frame's dots (the script's group). Each step is a
// rate a second times this frame's share of it (iTimeDelta), so the trail
// looks the same at any frame rate.
uniform float3 iResolution;
uniform float iTime;
uniform float iTimeDelta;
uniform shader uLast;
uniform shader uDots;
uniform float uFade;

half4 main(float2 p) {
  float2 c = iResolution.xy * 0.5;
  float2 d = p - c;
  float a = 0.12 * sin(iTime * 0.7) * iTimeDelta;
  float2 q = c + float2(d.x * cos(a) - d.y * sin(a), d.x * sin(a) + d.y * cos(a)) * pow(0.7859, iTimeDelta);
  q += float2(sin(p.y * 0.013 + iTime), cos(p.x * 0.011 - iTime)) * 24.0 * iTimeDelta;
  // A blur spreads with the square root of time: 6.57 px over a second.
  float s = 6.57 * sqrt(iTimeDelta);
  half4 last = 0.25 * (uLast.eval(q + float2(s, 0)) + uLast.eval(q - float2(s, 0))
                    + uLast.eval(q + float2(0, s)) + uLast.eval(q - float2(0, s)));
  last *= half(pow(uFade, iTimeDelta));
  half4 dots = uDots.eval(p);
  return dots + last * (1.0 - dots.a);
}
