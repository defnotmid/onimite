// fframes-three-d's `Environment::studio()` (its Studio::radiance), as an equirectangular
// image for bake{}: a dim sky to ground gradient and four softboxes, a large key light above
// at the front left, a strip on the right, a rim strip behind and a soft light above. It is
// drawn relative to its brightest light, the key at 3.3, and in sRGB; the views'
// environment_intensity puts the 3.3 back.
uniform float3 iResolution;

const float PEAK = 3.3;

float srgb(float c) { return c <= 0.0031308 ? c * 12.92 : 1.055 * pow(c, 1.0 / 2.4) - 0.055; }

// a softbox `w` x `h` degrees toward `dir` (its width along the horizon), its edges soft
float3 box(float3 d, float3 dir, float w, float h, float3 color) {
  dir = normalize(dir);
  float c = dot(d, dir);
  if (c <= -0.2) return float3(0.0);
  float3 u = cross(dir, float3(0.0, 1.0, 0.0));
  u = length(u) > 1e-6 ? normalize(u) : float3(1.0, 0.0, 0.0);
  float3 v = cross(u, dir);
  float2 hs = radians(float2(w, h)) * 0.5;
  const float soft = 0.015;
  float a = 1.0 - smoothstep(hs.x - soft * 0.5, hs.x + soft, abs(atan(dot(d, u), c)));
  float b = 1.0 - smoothstep(hs.y - soft * 0.5, hs.y + soft, abs(atan(dot(d, v), c)));
  // the soft edge spreads the light: the box keeps its energy
  return color * a * b * (hs.x * hs.y) / ((hs.x + soft * 0.75) * (hs.y + soft * 0.75));
}

half4 main(float2 p) {
  float2 uv = p / iResolution.xy;                 // equirectangular: u around, v down
  float lon = uv.x * 6.2831853, lat = (0.5 - uv.y) * 3.14159265;
  float3 d = float3(cos(lat) * sin(lon), sin(lat), cos(lat) * cos(lon));
  float3 horizon = float3(0.12, 0.12, 0.13);
  float3 c = d.y >= 0.0 ? mix(horizon, float3(0.05, 0.055, 0.065), smoothstep(0.0, 0.43, d.y))
                        : mix(horizon, float3(0.02, 0.02, 0.022), smoothstep(0.0, 0.08, -d.y));
  c += box(d, float3(-0.6, 0.75, 0.6), 50.0, 30.0, float3(3.2, 3.2, 3.3));
  c += box(d, float3(1.0, 0.2, 0.15), 14.0, 70.0, float3(2.4, 2.45, 2.6));
  c += box(d, float3(-0.3, 0.35, -1.0), 70.0, 8.0, float3(1.8, 1.9, 2.1));
  c += box(d, float3(0.0, 1.0, 0.0), 40.0, 40.0, float3(0.9, 0.9, 0.95));
  c = clamp(c / PEAK, 0.0, 1.0);
  return half4(half(srgb(c.r)), half(srgb(c.g)), half(srgb(c.b)), 1.0);
}
