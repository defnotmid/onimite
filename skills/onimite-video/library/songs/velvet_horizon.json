{
  "name": "velvet_horizon",
  "description": "French-touch / melodic nu-disco in F Dorian at 112 bpm with 16th-note swing (0.16), showcasing layered hybrid sound design: (1) symphonic_pad fuses a real sampled string ensemble (vsco2/strings) and a 7-voice stereo fatsawtooth + sub sine inside one node graph sharing a 24 dB resonant filter and cutoff knob; (2) layered_bass stacks a fingered jazz bass (karoryfer/growlybass with round robins) over a diode-ladder synth sub; (3) layered_keys stacks an intimate grand piano (osiris/soft_piano), an FM Rhodes (keys), and a bell layer chosen by velocity (lo_vel 96: about half the break's chords and a fifth of the intro's and verse's, never the drops); (4) karplus_pluck uses a tuned Comb resonator excited by a noise burst and saw transient; (5) drums pair a 909 kick/clap with a high-passed stereo acoustic jazz kit (virtuosity/drums) playing ghost notes, rides, and 4-bar tom/snare fills through a compressed drumbus; (6) velvet_lead doubles a ladder synth lead with a solo violin played from VS Chamber Orchestra 2's own SFZ through the song's `sources` (pinned in pins/vsco.pins).",
  "sources": {
    "vsco": {
      "url": "https://raw.githubusercontent.com/sgossner/VSCO-2-CE/6dd651d55dde97fd4028699be9d4481f26917891/",
      "page": "https://github.com/sgossner/VSCO-2-CE/tree/SFZ",
      "licence": "CC0-1.0",
      "credit": "VS Chamber Orchestra 2: Community Edition by Versilian Studios LLC (Sam Gossner, Simon Dalzell, Elan Hickler), CC0 1.0",
      "pins": "pins/vsco.pins"
    }
  },
  "instruments": [
    "instruments/synths.json",
    {
      "symphonic_pad": {
        "description": "Sampled chamber strings (vsco2/strings) and 7 detuned saws + sub sine summed into one 24 dB resonant filter with envelope, slow LFO drift, velocity, and key tracking.",
        "options": {
          "cutoff": "lp/frequency",
          "resonance": "lp/q",
          "attack": [ "env/attack", "fenv/attack" ],
          "release": [ "env/release", "fenv/release", "strings/release" ]
        },
        "nodes": {
          "strings": { "class": "Sampler", "set": "vsco2/strings", "attack": 0.35, "release": 1.4, "gain_db": -16 },
          "saws": { "class": "Osc", "wave": "fatsawtooth", "count": 7, "spread": 20, "width": 0.9, "phase": "random", "gain_db": -3 },
          "sub": { "class": "Osc", "wave": "sine", "ratio": 0.5, "gain_db": -14 },
          "blend": { "class": "Mix", "inputs": [ "strings", "saws", "sub" ] },
          "track": { "class": "Map", "input": "key", "offset": -60 },
          "fenv": { "class": "Env", "attack": 1.0, "decay": 2.2, "sustain": 0.65, "release": 1.8 },
          "drift": { "class": "Lfo", "rate": 0.17, "phase": 0.25 },
          "lp": {
            "class": "Filter",
            "type": "lowpass",
            "rolloff": -24,
            "q": 1.1,
            "input": "blend",
            "frequency": [
              { "base": 520, "by": "fenv", "octaves": 1.8 },
              { "by": "velocity", "octaves": 1.0 },
              { "by": "track", "octaves": 0.04167 },
              { "by": "drift", "octaves": 0.25 }
            ]
          },
          "hp": { "class": "Filter", "type": "highpass", "frequency": 160, "input": "lp" },
          "env": { "class": "Env", "attack": 0.45, "decay": 0, "sustain": 1, "release": 1.6 },
          "out": { "class": "Mix", "inputs": [ "hp" ], "amp": "env", "gain_db": -10.5 }
        }
      },
      "layered_bass": {
        "description": "Two layers on every note: Karoryfer Growlybass (sampled fingered Jazz Bass with round robins) for midrange string articulation, plus a monophonic diode-ladder synth bass anchoring the sub.",
        "layers": [
          {
            "instrument": { "name": "Sampler", "set": "karoryfer/growlybass", "release": 0.09 },
            "gain_db": -22.5
          },
          {
            "instrument": { "name": "bass", "cutoff": 135, "resonance": 1.8, "pluck": 2.4 },
            "gain_db": 1.5
          }
        ]
      },
      "layered_keys": {
        "description": "Three-layer hybrid keys: Osiris soft grand piano for hammer body, FM electric piano for warm sustain, and an FM bell layer that plays only from MIDI velocity 96 (0.76): layers choose by velocity, and an accent (X) doesn't raise it, so here, with humanize's ×0.92–1.08 jitter, the bell rings on about half the break's hits (0.76) and a fifth of the intro's and verse's (0.72), never in the drops (0.68).",
        "layers": [
          {
            "instrument": { "name": "Sampler", "set": "osiris/soft_piano", "release": 0.7 },
            "gain_db": -17.5
          },
          {
            "instrument": { "name": "keys", "brightness": 1.5 },
            "gain_db": -3.5
          },
          {
            "instrument": { "name": "bell", "brightness": 1.8, "decay": 1.2 },
            "lo_vel": 96,
            "hi_vel": 127,
            "gain_db": -4.0
          }
        ]
      },
      "karplus_pluck": {
        "description": "Physical-modeled plucked string using a tuned Comb resonator (delay 0 tracks the note period) excited by a pink noise burst and a short stereo saw transient.",
        "options": {
          "damp": "string/damp",
          "feedback": "string/feedback"
        },
        "nodes": {
          "burst_env": { "class": "Decay", "attack": 0.001, "time": 0.012 },
          "noise": { "class": "Noise", "color": "pink", "amp": "burst_env", "gain_db": -6 },
          "saw_env": { "class": "Decay", "attack": 0.001, "time": 0.035 },
          "saw": { "class": "Osc", "wave": "fatsawtooth", "count": 3, "spread": 10, "width": 0.65, "amp": "saw_env", "gain_db": -8 },
          "excite": { "class": "Mix", "inputs": [ "noise", "saw" ] },
          "string": { "class": "Comb", "input": "excite", "delay": 0, "feedback": 0.93, "damp": 4200, "release": 0.35 },
          "body": { "class": "Filter", "type": "highpass", "frequency": 220, "input": "string" },
          "env": { "class": "Env", "attack": 0.001, "decay": 0.8, "sustain": 0, "release": 0.35 },
          "out": { "class": "Mix", "inputs": [ "body", "saw" ], "amp": "env", "gain_db": -7.5 }
        }
      },
      "analog_hook": {
        "description": "Expressive mono lead: a micro pitch-scoop on attack (18 ms), 3 warm saws + triangle sub through the saturating diode Ladder filter (warmer than a 12 dB SVF), a dynamic decaying amp contour (not flat organ sustain), and delayed vibrato.",
        "mono": true,
        "portamento": 0.055,
        "nodes": {
          "scoop": { "class": "Decay", "time": 0.018 },
          "vib": { "class": "Lfo", "rate": 5.2, "delay": 0.22, "fade": 0.3 },
          "saws": {
            "class": "Osc",
            "wave": "fatsawtooth",
            "count": 3,
            "spread": 10,
            "width": 0.35,
            "phase": "random",
            "frequency": [
              { "by": "vib", "octaves": 0.007 },
              { "by": "scoop", "octaves": -0.025 }
            ]
          },
          "sub": {
            "class": "Osc",
            "wave": "triangle",
            "ratio": 0.5,
            "gain_db": -8,
            "frequency": { "by": "vib", "octaves": 0.007 }
          },
          "breath_env": { "class": "Decay", "attack": 0.002, "time": 0.04 },
          "breath": { "class": "Noise", "color": "pink", "amp": "breath_env", "gain_db": -22 },
          "raw": { "class": "Mix", "inputs": [ "saws", "sub", "breath" ] },
          "track": { "class": "Map", "input": "key", "offset": -60 },
          "fenv": { "class": "Env", "attack": 0.012, "decay": 0.38, "sustain": 0.28, "release": 0.25 },
          "ladder": {
            "class": "Ladder",
            "input": "raw",
            "q": 2.4,
            "frequency": [
              { "base": 680, "by": "fenv", "octaves": 2.1 },
              { "by": "velocity", "octaves": 0.9 },
              { "by": "track", "octaves": 0.05 }
            ]
          },
          "hp": { "class": "Filter", "type": "highpass", "frequency": 240, "input": "ladder" },
          "env": { "class": "Env", "attack": 0.008, "decay": 0.55, "sustain": 0.62, "release": 0.22 },
          "out": { "class": "Mix", "inputs": [ "hp" ], "amp": "env", "gain_db": -11.5 }
        }
      },
      "velvet_lead": {
        "description": "Hybrid lead: the diode-ladder analog_hook doubled by a solo violin with vibrato, played from VS Chamber Orchestra 2's own SFZ (vsco/SViolinVib.sfz, its samples fetched through the song's `sources` and pinned in pins/vsco.pins), its attack slowed and its release shortened by opcode overrides, so each note has a bowed body under the synth.",
        "layers": [
          {
            "instrument": "analog_hook",
            "gain_db": 0.0
          },
          {
            "instrument": { "name": "vsco/SViolinVib.sfz", "ampeg_attack": 0.04, "ampeg_release": 0.35 },
            "gain_db": -3.3
          }
        ]
      }
    }
  ],
  "key": "F dorian",
